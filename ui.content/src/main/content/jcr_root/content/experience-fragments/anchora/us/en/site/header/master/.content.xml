<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/anchora/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="anchora/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="anchora/components/container"
            layout="simple">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="anchora/components/header"
                brandLabel="Anchora"
                brandLink="/content/anchora/us/en"
                navLabel="Main">
                <links jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        label="Home"
                        link="/content/anchora/us/en"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        label="Flying with children"
                        link="/content/anchora/us/en/flying-infants-children"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        label="Joey Club"
                        link="/content/anchora/us/en/joey-club"/>
                    <item3
                        jcr:primaryType="nt:unstructured"
                        label="Help"
                        link="https://www.example.com/help"
                        newTab="{Boolean}true"/>
                </links>
            </header>
        </root>
    </jcr:content>
</jcr:root>
