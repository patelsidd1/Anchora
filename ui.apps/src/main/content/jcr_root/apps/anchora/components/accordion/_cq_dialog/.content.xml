<?xml version="1.0" encoding="UTF-8"?>
<!--
    Overlays the Core Accordion dialog through the Sling Resource Merger: only the differences are listed here.
    - adds a "Section" tab for the section heading and introduction (AC-01), and the "Expand all" button labels;
    - adds a hint under the Items list that answers and links are edited in each Accordion item;
    - hides the "Expanded items" selects, because every item starts collapsed (AC-04).
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured">
    <content jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured">
                <items jcr:primaryType="nt:unstructured">
                    <section
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Section"
                        sling:orderBefore="containerItems"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <sectionTitle
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldDescription="Heading shown above the items, rendered as an H2."
                                fieldLabel="Section heading"
                                name="./sectionTitle"
                                required="{Boolean}true"/>
                            <sectionIntro
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                fieldDescription="Optional short paragraph under the heading."
                                fieldLabel="Introduction"
                                name="./sectionIntro"/>
                            <expandAllLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                emptyText="Expand all items"
                                fieldDescription="Optional. Leave blank to use &quot;Expand all items&quot;. The button is only shown when more than one item can be open at a time and there are at least two items."
                                fieldLabel="Expand all label"
                                name="./expandAllLabel"/>
                            <collapseAllLabel
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                emptyText="Collapse all items"
                                fieldDescription="Optional. Shown on the same button once every item is open. Leave blank to use &quot;Collapse all items&quot;."
                                fieldLabel="Collapse all label"
                                name="./collapseAllLabel"/>
                        </items>
                    </section>
                    <containerItems jcr:primaryType="nt:unstructured">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured">
                                        <items jcr:primaryType="nt:unstructured">
                                            <linksHint
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                                text="Answers and their links are edited on the page: close this dialog, select an item's answer and choose Configure (wrench), then the Links tab."/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </containerItems>
                    <properties jcr:primaryType="nt:unstructured">
                        <items jcr:primaryType="nt:unstructured">
                            <columns jcr:primaryType="nt:unstructured">
                                <items jcr:primaryType="nt:unstructured">
                                    <column jcr:primaryType="nt:unstructured">
                                        <items jcr:primaryType="nt:unstructured">
                                            <expandedSelect
                                                jcr:primaryType="nt:unstructured"
                                                sling:hideResource="{Boolean}true"/>
                                            <expandedSelectSingle
                                                jcr:primaryType="nt:unstructured"
                                                sling:hideResource="{Boolean}true"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </properties>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
