<?xml version="1.0" encoding="UTF-8"?>
<!--
    Overlays the Core Text dialog (through anchora/components/text) with the Sling Resource Merger:
    the "Properties" tab with the rich text editor is unchanged, and a "Links" tab is added after it.
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Accordion item">
    <content jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured">
                <items jcr:primaryType="nt:unstructured">
                    <links
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Links"
                        sling:orderBefore="styletab"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <links
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                composite="{Boolean}true"
                                fieldDescription="Optional. Shown under the text in bold with an arrow, for example &quot;More about bassinets&quot;."
                                fieldLabel="Links">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./links">
                                    <items jcr:primaryType="nt:unstructured">
                                        <label
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Label"
                                            name="./label"
                                            required="{Boolean}true"/>
                                        <link
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                            fieldDescription="A page in this site or a full external URL."
                                            fieldLabel="Link"
                                            name="./link"
                                            required="{Boolean}true"
                                            rootPath="/content"/>
                                        <newTab
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                            name="./newTab"
                                            text="Open in a new tab"
                                            uncheckedValue="{Boolean}false"
                                            value="{Boolean}true"/>
                                    </items>
                                </field>
                            </links>
                        </items>
                    </links>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>